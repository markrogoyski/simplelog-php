{
  "name": "markrogoyski/simplelog-php",
  "type": "library",
  "description": "Minimal composer config for CI unit tests on PHP 8.1+",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "psr/log": "^3.0",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "php-parallel-lint/php-parallel-lint": "^1.4"
  },
  "autoload": {
    "psr-4": {"SimpleLog\\": "src/"}
  },
  "autoload-dev": {
    "psr-4": { "SimpleLog\\Tests\\": "tests/" }
  }
}
